rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Reusable Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidDevice(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 256
        && data.model is string && data.model.size() <= 128
        && data.serialNumber is string && data.serialNumber.size() <= 128
        && (!('manufacturer' in data) || (data.manufacturer is string && data.manufacturer.size() <= 128))
        && (!('origin' in data) || (data.origin is string && data.origin.size() <= 128))
        && (!('yearOfProduction' in data) || data.yearOfProduction is int || data.yearOfProduction is float || (data.yearOfProduction is string && data.yearOfProduction.size() <= 32))
        && (!('expiryGCP' in data) || (data.expiryGCP is string && data.expiryGCP.size() <= 64))
        && (!('expiryGKD' in data) || (data.expiryGKD is string && data.expiryGKD.size() <= 64))
        && (!('expiryGKX' in data) || (data.expiryGKX is string && data.expiryGKX.size() <= 64))
        && (!('gcpIssueDate' in data) || (data.gcpIssueDate is string && data.gcpIssueDate.size() <= 64))
        && (!('gcpPeriod' in data) || data.gcpPeriod is int || data.gcpPeriod is float || (data.gcpPeriod is string && data.gcpPeriod.size() <= 32))
        && (!('gkdIssueDate' in data) || (data.gkdIssueDate is string && data.gkdIssueDate.size() <= 64))
        && (!('gkdPeriod' in data) || data.gkdPeriod is int || data.gkdPeriod is float || (data.gkdPeriod is string && data.gkdPeriod.size() <= 32))
        && (!('gkxIssueDate' in data) || (data.gkxIssueDate is string && data.gkxIssueDate.size() <= 64))
        && (!('gkxPeriod' in data) || data.gkxPeriod is int || data.gkxPeriod is float || (data.gkxPeriod is string && data.gkxPeriod.size() <= 32))
        && (!('manager' in data) || (data.manager is string && data.manager.size() <= 128))
        && (!('lastMaintenance' in data) || (data.lastMaintenance is string && data.lastMaintenance.size() <= 64))
        && (!('maintenancePeriod' in data) || data.maintenancePeriod is int || data.maintenancePeriod is float || (data.maintenancePeriod is string && data.maintenancePeriod.size() <= 32))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000))
        && (!('noteDate' in data) || (data.noteDate is string && data.noteDate.size() <= 64))
        && (!('notesList' in data) || (data.notesList is list && data.notesList.size() <= 500));
    }

    function isValidActivityLog(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && (!('deviceId' in data) || (data.deviceId is string && data.deviceId.size() <= 128) || data.deviceId is int || data.deviceId is float)
        && (!('date' in data) || (data.date is string && data.date.size() <= 64))
        && (!('user' in data) || (data.user is string && data.user.size() <= 128))
        && (!('type' in data) || (data.type is string && data.type.size() <= 64))
        && (!('categoryLabel' in data) || (data.categoryLabel is string && data.categoryLabel.size() <= 128))
        && (!('description' in data) || (data.description is string && data.description.size() <= 4000))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000));
    }

    function isValidUserSettings(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('telegramBotToken' in data) || (data.telegramBotToken is string && data.telegramBotToken.size() <= 256))
        && (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 128))
        && (!('telegramEnabled' in data) || (data.telegramEnabled is bool))
        && (!('warningDaysGCP' in data) || (data.warningDaysGCP is int) || (data.warningDaysGCP is float) || (data.warningDaysGCP is string))
        && (!('warningDaysGKD' in data) || (data.warningDaysGKD is int) || (data.warningDaysGKD is float) || (data.warningDaysGKD is string))
        && (!('warningDaysGKX' in data) || (data.warningDaysGKX is int) || (data.warningDaysGKX is float) || (data.warningDaysGKX is string))
        && (!('warningDaysBD' in data) || (data.warningDaysBD is int) || (data.warningDaysBD is float) || (data.warningDaysBD is string))
        && (!('recipientEmail' in data) || (data.recipientEmail is string && data.recipientEmail.size() <= 256))
        && (!('isSubscribed' in data) || (data.isSubscribed is bool))
        && (!('hasSeeded' in data) || (data.hasSeeded is bool))
        && (!('channels' in data) || (data.channels is map));
    }

    function isValidDriveConfig(data) {
      return (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('connected' in data) || data.connected is bool)
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('accessToken' in data) || (data.accessToken is string && data.accessToken.size() <= 8192))
        && (!('driveFolderIds' in data) || (data.driveFolderIds is map))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // --- Collection Routes ---

    // 1. Connection test route
    match /test/{testId} {
      allow read, write: if true;
    }

    // 2. Devices Collection Rules
    match /devices/{deviceId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(deviceId) 
        && incoming().userId == request.auth.uid
        && (!('id' in incoming()) || incoming().id == deviceId)
        && isValidDevice(incoming());
        
      allow update: if isSignedIn() 
        && isValidId(deviceId) 
        && incoming().userId == request.auth.uid
        && isValidDevice(incoming());
        
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }

    // 3. ActivityLogs Collection Rules
    match /activityLogs/{logId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(logId) 
        && incoming().userId == request.auth.uid
        && (!('id' in incoming()) || incoming().id == logId) 
        && isValidActivityLog(incoming());
        
      allow update: if isSignedIn() 
        && isValidId(logId) 
        && incoming().userId == request.auth.uid
        && (!('id' in incoming()) || incoming().id == logId) 
        && isValidActivityLog(incoming());
        
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || !('userId' in resource.data));
    }

    // 4. UserSettings Collection Rules
    match /userSettings/{userId} {
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && incoming().userId == request.auth.uid
        && isValidUserSettings(incoming());
      allow delete: if isSignedIn() && userId == request.auth.uid;
    }

    // 5. GlobalDriveConfig Collection Rules
    match /globalDriveConfig/{configId} {
      allow read: if isSignedIn() && isValidId(configId);
      allow create, update: if isSignedIn()
        && isValidId(configId)
        && isValidDriveConfig(incoming());
      allow delete: if isSignedIn() && isValidId(configId);
    }
  }
}
